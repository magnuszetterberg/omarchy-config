#!/bin/bash
# Override: append the "Are u nuts?" pseudo-profile (raised CPU power caps via
# /usr/local/bin/zbook-power-caps) to the stock power-profile list. When it is
# active the real power-profiles-daemon entries are reported inactive so only
# one button lights up in the shell. While the mode is on but the 200 W barrel
# adapter is missing the entry is renamed to tell the user what to do; the set
# override accepts both names.
NUTS_LABEL="Are u nuts?"
WAIT_LABEL="Plug in 200W charger"

nuts=0
[[ $(cat /var/lib/zbook-power-caps/mode 2>/dev/null) == nuts ]] && nuts=1

# Barrel adapter = AC online and the firmware's sustained cap raised to 70 W
# (USB-C sources only get 35 W). ZBOOK_BARREL=0/1 overrides it for testing.
barrel=${ZBOOK_BARREL:-}
if [[ -z $barrel ]]; then
  barrel=0
  if [[ $(cat /sys/class/power_supply/AC/online 2>/dev/null) == 1 ]] &&
     (( $(cat /sys/class/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw 2>/dev/null || echo 0) >= 70000000 )); then
    barrel=1
  fi
fi

label=$NUTS_LABEL
(( nuts && !barrel )) && label=$WAIT_LABEL

/usr/bin/omarchy-powerprofiles-list "$@" |
  awk -F'\t' -v OFS='\t' -v nuts="$nuts" '{ if (nuts && NF > 1) $2 = 0; print }'
if [[ ${1:-} == --active-state ]]; then
  printf '%s\t%s\n' "$label" "$nuts"
else
  echo "$label"
fi
